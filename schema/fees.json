  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How is the fee for my case set?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Three things shape the fee: the allegation, the court, and the work the case actually requires. A specific fee is agreed during the first call and set out in writing, with VAT identified separately, in a client-care letter before any work is instructed."
        }
      },
      {
        "@type": "Question",
        "name": "Is legal aid available?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Astons Law Chambers is not a legal aid contract holder. Where legal aid applies, the case is referred to a partner solicitor firm at no cost. The first call is free either way."
        }
      },
      {
        "@type": "Question",
        "name": "Is the first call free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The first call carries no fee. It is where the allegation, the stage of the case, and the fee are discussed. A written fee is provided before any instruction is accepted."
        }
      },
      {
        "@type": "Question",
        "name": "Can one barrister handle both litigation and advocacy to reduce fees?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Where a case suits a single counsel, instructing one barrister authorised to conduct litigation can replace separate solicitor and barrister fees with a single fee structure."
        }
      }
    ]
